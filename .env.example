# Run real model calls only after setting both provider keys.
LINGOFUSION_REAL_MODELS=true
OPENAI_API_KEY=replace_with_your_openai_key
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# Local API server port. The Vite development server proxies /api and /v1 to it.
LINGOFUSION_API_PORT=8787

# Set this only for a deployed frontend, never to a private key.
# VITE_LINGOFUSION_API_URL=https://api.your-domain.example
