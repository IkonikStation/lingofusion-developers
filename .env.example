# Run real model calls only after setting both provider keys.
LINGOFUSION_REAL_MODELS=true
OPENAI_API_KEY=replace_with_your_openai_key
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# Sales acknowledgement emails are sent through Resend. The from address must use
# a domain verified in Resend (for example, sales@your-domain.example).
RESEND_API_KEY=replace_with_your_resend_key
LINGOFUSION_EMAIL_FROM=LingoFusion Sales <sales@your-domain.example>

# Local API server port. The Vite development server proxies /api and /v1 to it.
LINGOFUSION_API_PORT=8787

# Image translation (Playground) uses the LingoFusion Image Translate model.
# The edits endpoint is derived from LINGOFUSION_UPSTREAM_URL by default; set it
# explicitly here if your gateway exposes images at a different path.
# LINGOFUSION_UPSTREAM_IMAGE_URL=https://api.openai.com/v1/images/edits
# Output size requested for each image tier (upstream caps the longest edge at 3840px).
# LINGOFUSION_IMAGE_SIZE_STANDARD=1024x1024
# LINGOFUSION_IMAGE_SIZE_4K=3840x2160

# LingoFusion Native uses the loaded LM Studio model through its OpenAI-compatible
# local server. No real API key is needed.
LINGOFUSION_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Set this only for a deployed frontend, never to a private key.
# VITE_LINGOFUSION_API_URL=https://api.your-domain.example

# Stripe Checkout & Webhook configuration (server-side only — never expose STRIPE_SECRET_KEY in client code)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
APP_URL=https://ikonikstation.github.io/lingofusion-developers/playground

# OAuth sign-in (set on the Cloudflare Worker, not in the frontend).
#   wrangler secret put SESSION_SECRET      (any long random string)
#   wrangler secret put GOOGLE_CLIENT_ID    (Google Cloud Console -> OAuth 2.0 Web client)
#   wrangler secret put APPLE_CLIENT_ID     (Apple Developer -> Services ID)
# Google: add https://ikonikstation.github.io as an Authorized JavaScript origin.
# Apple: register https://ikonikstation.github.io/lingofusion-developers/ as a Return URL.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
SESSION_SECRET=
